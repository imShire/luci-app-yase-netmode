#!/bin/sh

# yase-netmode - wired WAN / 5G cellular exit policy switcher
# Forked from luci-app-h5000m-netmode (FAN789, Apache-2.0).
# The 5G uplink is the netifd logical interface "usbwan" (device usb0);
# its IPv6 companion is "usbwan6" or any interface stacked on @usbwan.

TAG="yase-netmode"
LOCK_DIR="/var/lock/yase-netmode.lock"
EXIT_STATE_FILE="/var/run/yase-netmode.exit"

# Off-link targets used to ask the kernel which exit it would really use. Any
# globally routable address works; these are only ever looked up, never sent to.
PROBE4="1.1.1.1"
PROBE6="2606:4700:4700::1111"

mode="$(uci -q get yase_netmode.settings.mode || echo wan_first)"

normalize_mode() {
	case "$mode" in
		wan_first|modem_first|wan_only|modem_only) ;;
		*) mode="wan_first" ;;
	esac
}

bool_value() {
	case "$1" in
		1|true) echo 1 ;;
		*) echo 0 ;;
	esac
}

interface_exists() {
	uci -q get "network.$1" >/dev/null 2>&1
}

append_modem_section() {
	local section="$1"
	[ -n "$section" ] || return 0
	case " $MODEM_SECTIONS " in
		*" $section "*) ;;
		*) MODEM_SECTIONS="${MODEM_SECTIONS:+$MODEM_SECTIONS }$section" ;;
	esac
}

discover_modem_interfaces() {
	local section device

	MODEM_SECTIONS=""
	MODEM_PRIMARY=""
	MODEM6_PRIMARY=""

	# The 5G uplink is the fixed netifd logical interface "usbwan".
	if interface_exists usbwan; then
		MODEM_PRIMARY="usbwan"
		append_modem_section usbwan
	fi

	# IPv6 companion: prefer a dedicated usbwan6 section, otherwise accept any
	# interface stacked on @usbwan (netifd alias style).
	for section in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.]*\)=interface$/\1/p'); do
		[ "$section" = "usbwan" ] && continue
		device="$(uci -q get "network.${section}.device" || uci -q get "network.${section}.ifname" || true)"
		if [ "$section" = "usbwan6" ] || [ "$device" = "@usbwan" ]; then
			append_modem_section "$section"
			[ -n "$MODEM6_PRIMARY" ] || MODEM6_PRIMARY="$section"
		fi
	done
}

read_interface() {
	local name="$1" json value

	IFACE_PRESENT=0
	IFACE_UP=0
	IFACE_AVAILABLE=0
	IFACE_DEVICE=""
	interface_exists "$name" && IFACE_PRESENT=1

	json="$(ubus call "network.interface.$name" status 2>/dev/null || true)"
	[ -n "$json" ] || {
		IFACE_DEVICE="$(uci -q get "network.$name.device" || uci -q get "network.$name.ifname" || true)"
		return 0
	}

	value="$(printf '%s' "$json" | jsonfilter -e '@.up' 2>/dev/null || true)"
	IFACE_UP="$(bool_value "$value")"
	value="$(printf '%s' "$json" | jsonfilter -e '@.available' 2>/dev/null || true)"
	IFACE_AVAILABLE="$(bool_value "$value")"
	IFACE_DEVICE="$(printf '%s' "$json" | jsonfilter -e '@.l3_device' 2>/dev/null || true)"
	[ -n "$IFACE_DEVICE" ] || IFACE_DEVICE="$(printf '%s' "$json" | jsonfilter -e '@.device' 2>/dev/null || true)"
	[ -n "$IFACE_DEVICE" ] || IFACE_DEVICE="$(uci -q get "network.$name.device" || uci -q get "network.$name.ifname" || true)"
}

route_device() {
	printf '%s\n' "$1" | sed -n 's/.* dev \([^ ]*\).*/\1/p'
}

# The default route the kernel actually prefers, i.e. the one with the lowest
# metric. `ip route show default` lists every default route (the priority modes
# give both uplinks one) and its order is not metric sorted, so picking the
# first line can select the route that is losing.
best_default_route() {
	ip "-$1" route show default 2>/dev/null | awk '
		{
			metric = 0; device = ""
			for (i = 1; i < NF; i++) {
				if ($i == "metric") metric = $(i + 1)
				if ($i == "dev") device = $(i + 1)
			}
			if (device == "") next
			if (found == 0 || metric < best_metric) {
				found = 1; best_metric = metric; best = $0
			}
		}
		END { if (found) print best }
	'
}

# Device behind the route a lookup for an off-link target resolves to. This is
# authoritative during a failover, when the losing route may still be in the
# table while the winning one is already being installed.
lookup_exit_device() {
	ip "-$1" route get "$2" 2>/dev/null \
		| sed -n 's/.* dev \([^ ]*\).*/\1/p' \
		| head -n 1
}

has_default_route() {
	local family="$1" device="$2"
	[ -n "$device" ] || return 1
	ip "-${family}" route show default 2>/dev/null | awk -v device="$device" '
		{
			for (i = 1; i < NF; i++)
				if ($i == "dev" && $(i + 1) == device)
					found = 1
		}
		END { exit found ? 0 : 1 }
	'
}

device_matches() {
	local device="$1" candidate
	shift
	for candidate in "$@"; do
		[ -n "$candidate" ] && [ "$device" = "$candidate" ] && return 0
	done
	return 1
}

route_owner() {
	local device="$1"
	shift
	[ -n "$device" ] || { echo none; return 0; }
	if device_matches "$device" "$WAN_DEVICE" "$WAN6_DEVICE"; then
		echo wan
	elif device_matches "$device" "$MODEM_DEVICE" "$MODEM6_DEVICE"; then
		echo modem
	else
		echo other
	fi
}

store_exit_state() {
	local owner="$1" temporary

	temporary="${EXIT_STATE_FILE}.new.$$"
	umask 077
	printf '%s\n' "$owner" > "$temporary" || return 1
	mv -f "$temporary" "$EXIT_STATE_FILE"
}

reload_proxies_on_exit_change() {
	local current previous pid svc

	read_live_state
	current="$ACTIVE4"
	case "$current" in
		wan|modem) ;;
		*) return 0 ;;
	esac

	previous="$(cat "$EXIT_STATE_FILE" 2>/dev/null || true)"
	case "$previous" in
		wan|modem) ;;
		*)
			store_exit_state "$current"
			logger -t "$TAG" "recorded initial IPv4 exit=$current"
			return 0
			;;
	esac
	[ "$previous" != "$current" ] || return 0

	# daed exposes hot reload only through its authenticated GraphQL API. Signals
	# and the generic OpenWrt reload action do not apply its selected profile, so
	# use the procd-managed restart path. If daed is stopped, its next start will
	# detect the live route.
	pid="$(pgrep -f '^/usr/bin/daed run([[:space:]]|$)' 2>/dev/null | head -n 1)"
	if [ -n "$pid" ] && [ -x /etc/init.d/daed ]; then
		if /etc/init.d/daed restart >/dev/null 2>&1; then
			logger -t "$TAG" "restarted daed after IPv4 exit changed ${previous}->${current}"
		else
			logger -t "$TAG" "failed to restart daed after IPv4 exit changed ${previous}->${current}"
		fi
	fi

	# Additional user-configured proxy services (space separated UCI list).
	# Only running services are reloaded so a stopped service is never started.
	for svc in $(uci -q get yase_netmode.settings.proxy_services); do
		case "$svc" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
		[ "$svc" = "daed" ] && continue
		[ -x "/etc/init.d/$svc" ] || continue
		/etc/init.d/"$svc" running >/dev/null 2>&1 || continue
		if /etc/init.d/"$svc" reload >/dev/null 2>&1 || /etc/init.d/"$svc" restart >/dev/null 2>&1; then
			logger -t "$TAG" "reloaded $svc after IPv4 exit changed ${previous}->${current}"
		else
			logger -t "$TAG" "failed to reload $svc after IPv4 exit changed ${previous}->${current}"
		fi
	done

	store_exit_state "$current" || return 1
	return 0
}

read_live_state() {
	local device

	discover_modem_interfaces

	read_interface wan
	WAN_PRESENT="$IFACE_PRESENT"; WAN_UP="$IFACE_UP"; WAN_AVAILABLE="$IFACE_AVAILABLE"; WAN_DEVICE="$IFACE_DEVICE"
	read_interface wan6
	WAN6_PRESENT="$IFACE_PRESENT"; WAN6_UP="$IFACE_UP"; WAN6_AVAILABLE="$IFACE_AVAILABLE"; WAN6_DEVICE="$IFACE_DEVICE"
	read_interface "${MODEM_PRIMARY:-__missing_modem__}"
	MODEM_PRESENT="$IFACE_PRESENT"; MODEM_UP="$IFACE_UP"; MODEM_AVAILABLE="$IFACE_AVAILABLE"; MODEM_DEVICE="$IFACE_DEVICE"
	read_interface "${MODEM6_PRIMARY:-__missing_modem6__}"
	MODEM6_PRESENT="$IFACE_PRESENT"; MODEM6_UP="$IFACE_UP"; MODEM6_AVAILABLE="$IFACE_AVAILABLE"; MODEM6_DEVICE="$IFACE_DEVICE"

	DEFAULT4="$(best_default_route 4)"
	DEFAULT6="$(best_default_route 6)"

	# A route lookup answers "which exit is in use" directly, instead of
	# inferring it from a default-route listing that still holds the route of a
	# link that has just gone away.
	device="$(lookup_exit_device 4 "$PROBE4")"
	[ -n "$device" ] || device="$(route_device "$DEFAULT4")"
	ACTIVE4="$(route_owner "$device")"

	device="$(lookup_exit_device 6 "$PROBE6")"
	[ -n "$device" ] || device="$(route_device "$DEFAULT6")"
	ACTIVE6="$(route_owner "$device")"
	WAN4_READY=0; WAN6_READY=0; MODEM4_READY=0; MODEM6_READY=0
	has_default_route 4 "$WAN_DEVICE" && WAN4_READY=1
	has_default_route 6 "${WAN6_DEVICE:-$WAN_DEVICE}" && WAN6_READY=1
	has_default_route 4 "$MODEM_DEVICE" && MODEM4_READY=1
	has_default_route 6 "${MODEM6_DEVICE:-$MODEM_DEVICE}" && MODEM6_READY=1
}

print_status() {
	read_live_state

	echo "mode=$mode"
	echo "ipv6_policy=follow_preferred"
	echo "ipv6_owner=$(uci -q get yase_netmode.settings.ipv6_owner || echo none)"
	echo "wan_present=$WAN_PRESENT"
	echo "wan_up=$WAN_UP"
	echo "wan6_up=$WAN6_UP"
	echo "wan4_ready=$WAN4_READY"
	echo "wan6_ready=$WAN6_READY"
	echo "wan_device=$WAN_DEVICE"
	echo "modem_present=$MODEM_PRESENT"
	echo "modem_up=$MODEM_UP"
	echo "modem6_up=$MODEM6_UP"
	echo "modem4_ready=$MODEM4_READY"
	echo "modem6_ready=$MODEM6_READY"
	echo "modem_device=$MODEM_DEVICE"
	echo "modem_interface=$MODEM_PRIMARY"
	echo "modem6_interface=$MODEM6_PRIMARY"
	echo "active4=$ACTIVE4"
	echo "active6=$ACTIVE6"
	echo "exit_state=$(cat "$EXIT_STATE_FILE" 2>/dev/null || echo none)"
	echo "wan_metric=$(uci -q get network.wan.metric || true)"
	echo "wan6_metric=$(uci -q get network.wan6.metric || true)"
	echo "usb_metric=$(uci -q get "network.${MODEM_PRIMARY:-usbwan}.metric" 2>/dev/null || true)"
	echo "usbv6_metric=$(uci -q get "network.${MODEM6_PRIMARY:-usbwan6}.metric" 2>/dev/null || true)"
	echo "wan_defaultroute=$(uci -q get network.wan.defaultroute || echo 1)"
	echo "wan6_defaultroute=$(uci -q get network.wan6.defaultroute || echo 1)"
	echo "wan6_auto=$(uci -q get network.wan6.auto || echo 1)"
	echo "usb_defaultroute=$(uci -q get "network.${MODEM_PRIMARY:-usbwan}.defaultroute" 2>/dev/null || echo 1)"
	echo "usbv6_defaultroute=$(uci -q get "network.${MODEM6_PRIMARY:-usbwan6}.defaultroute" 2>/dev/null || echo 1)"
	echo "usbv6_auto=$(uci -q get "network.${MODEM6_PRIMARY:-usbwan6}.auto" 2>/dev/null || echo 1)"
	echo "default4=$DEFAULT4"
	echo "default6=$DEFAULT6"
}

set_network_option() {
	local section="$1" option="$2" value="$3"
	interface_exists "$section" || return 0
	uci -q set "network.${section}.${option}=${value}"
}

set_network_option_if_changed() {
	local section="$1" option="$2" value="$3" current
	interface_exists "$section" || return 0
	current="$(uci -q get "network.${section}.${option}" || true)"
	[ "$current" = "$value" ] && return 0
	uci -q set "network.${section}.${option}=${value}" || return 1
	NETWORK_CHANGED=1
}

select_ipv6_owner() {
	read_live_state
	case "$mode" in
		wan_only) IPV6_OWNER="wan" ;;
		modem_only) IPV6_OWNER="modem" ;;
		wan_first|modem_first)
			case "$ACTIVE4" in
				wan|modem) IPV6_OWNER="$ACTIVE4" ;;
				*) [ "$mode" = "modem_first" ] && IPV6_OWNER="modem" || IPV6_OWNER="wan" ;;
			esac
		;;
	esac
}

align_ipv6_to_active4() {
	local previous_owner

	select_ipv6_owner
	previous_owner="$(uci -q get yase_netmode.settings.ipv6_owner || true)"
	NETWORK_CHANGED=0

	case "$IPV6_OWNER" in
		modem)
			set_network_option_if_changed wan6 defaultroute 0 || return 1
			set_network_option_if_changed wan6 auto 0 || return 1
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" defaultroute 1 || true
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" auto 1 || true
			;;
		*)
			IPV6_OWNER="wan"
			set_network_option_if_changed wan6 defaultroute 1 || return 1
			set_network_option_if_changed wan6 auto 1 || return 1
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" defaultroute 0 || true
			[ -n "$MODEM6_PRIMARY" ] && set_network_option_if_changed "$MODEM6_PRIMARY" auto 0 || true
			;;
	esac

	if [ "$previous_owner" != "$IPV6_OWNER" ]; then
		uci -q set "yase_netmode.settings.ipv6_owner=${IPV6_OWNER}" || return 1
		uci -q commit yase_netmode || return 1
	fi
	[ "$NETWORK_CHANGED" = "0" ] || uci -q commit network || return 1

	case "$IPV6_OWNER" in
		modem)
			[ "$WAN6_UP" != "1" ] || ifdown wan6 >/dev/null 2>&1 || true
			if [ "$MODEM_UP" = "1" ] && [ "$MODEM6_UP" != "1" ] && [ -n "$MODEM6_PRIMARY" ]; then
				ifup "$MODEM6_PRIMARY" >/dev/null 2>&1 || true
			fi
			;;
		wan)
			[ "$MODEM6_UP" != "1" ] || ifdown "$MODEM6_PRIMARY" >/dev/null 2>&1 || true
			if [ "$WAN_UP" = "1" ] && [ "$WAN6_UP" != "1" ]; then
				ifup wan6 >/dev/null 2>&1 || true
			fi
			;;
	esac

	if [ "$previous_owner" != "$IPV6_OWNER" ]; then
		logger -t "$TAG" "IPv6 owner changed ${previous_owner:-none}->${IPV6_OWNER} active4=${ACTIVE4} mode=${mode}"
	fi
	return 0
}

acquire_lock() {
	local owner
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	case "$owner" in
		''|*[!0-9]*) owner="" ;;
	esac
	if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
		rm -rf "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	return 1
}

release_lock() {
	rm -rf "$LOCK_DIR" 2>/dev/null
}

apply_policy() {
	local wan_metric modem_metric wan4_defaultroute wan6_defaultroute modem4_defaultroute modem6_defaultroute wan6_auto modem6_auto section device

	discover_modem_interfaces

	case "$mode" in
		modem_first)
			wan_metric=50; modem_metric=10
			wan4_defaultroute=1; wan6_defaultroute=0
			modem4_defaultroute=1; modem6_defaultroute=1
			wan6_auto=0; modem6_auto=1
			;;
		wan_only)
			wan_metric=10; modem_metric=50
			wan4_defaultroute=1; wan6_defaultroute=1
			modem4_defaultroute=0; modem6_defaultroute=0
			wan6_auto=1; modem6_auto=0
			;;
		modem_only)
			wan_metric=50; modem_metric=10
			wan4_defaultroute=0; wan6_defaultroute=0
			modem4_defaultroute=1; modem6_defaultroute=1
			wan6_auto=0; modem6_auto=1
			;;
		*)
			mode=wan_first
			wan_metric=10; modem_metric=50
			wan4_defaultroute=1; wan6_defaultroute=1
			modem4_defaultroute=1; modem6_defaultroute=0
			wan6_auto=1; modem6_auto=0
			;;
	esac

	set_network_option wan metric "$wan_metric" || return 1
	set_network_option wan6 metric "$wan_metric" || return 1
	set_network_option wan norelease 1 || return 1
	set_network_option wan defaultroute "$wan4_defaultroute" || return 1
	set_network_option wan6 defaultroute "$wan6_defaultroute" || return 1
	set_network_option wan6 auto "$wan6_auto" || return 1
	for section in $MODEM_SECTIONS; do
		set_network_option "$section" metric "$modem_metric" || return 1
		device="$(uci -q get "network.${section}.device" || uci -q get "network.${section}.ifname" || true)"
		if [ "$section" = "$MODEM6_PRIMARY" ] || [ "$device" = "@${MODEM_PRIMARY}" ]; then
			set_network_option "$section" defaultroute "$modem6_defaultroute" || return 1
			set_network_option "$section" auto "$modem6_auto" || return 1
		else
			set_network_option "$section" defaultroute "$modem4_defaultroute" || return 1
		fi
	done
	uci -q commit network || return 1

	return 0
}

# Persist the mode. Kept out of apply_policy so the caller decides when it is
# safe to write: print_status reports this value as the applied policy, so it
# must not be written until the network has actually taken it.
commit_mode() {
	uci -q set yase_netmode.settings='settings' || return 1
	uci -q set "yase_netmode.settings.mode=${mode}" || return 1
	if ! uci -q commit yase_netmode; then
		# Drop the staged mode. uci commits the whole pending delta of a
		# package, so any later commit of yase_netmode would fold in the mode
		# we just failed to persist -- align_ipv6_to_active4 makes exactly
		# such a commit when the caller rolls the network back, which would
		# restore the half-state this ordering exists to avoid.
		uci -q revert yase_netmode
		return 1
	fi

	return 0
}

# Put the network options back to those of mode $1 and make them live again.
# apply_policy is a pure function of $mode writing the same options
# idempotently, so re-running it is enough -- no snapshot of the eight options
# is needed. A failure here is logged but not fatal: the caller is already
# exiting non-zero, the mode was never persisted, and the next hotplug
# reconcile or reboot re-applies from the restored UCI.
rollback_policy() {
	mode="$1"
	normalize_mode
	apply_policy || logger -t "$TAG" "rollback of network options failed"
	/etc/init.d/network reload >/dev/null 2>&1 || logger -t "$TAG" "rollback reload failed"
	# Re-derive the IPv6 owner from the restored live state, so the rollback
	# lands in the same shape a normal apply would have produced.
	align_ipv6_to_active4 || true
}

normalize_mode
action="${1:-}"
case "$action" in
	status)
		print_status
		exit 0
		;;
	set)
		case "${2:-}" in
			wan_first|modem_first|wan_only|modem_only) mode="$2" ;;
			*) echo "invalid exit policy" >&2; exit 64 ;;
		esac
		;;
	reconcile) ;;
	apply|'') ;;
	*) echo "Usage: $0 {status|apply|reconcile|set MODE}" >&2; exit 64 ;;
esac

if ! acquire_lock; then
	echo "another exit policy update is already running" >&2
	exit 2
fi
trap release_lock EXIT INT TERM

if [ "$action" = "reconcile" ]; then
	if ! align_ipv6_to_active4; then
		logger -t "$TAG" "failed to align IPv6 with the active IPv4 exit"
		exit 1
	fi
	if ! reload_proxies_on_exit_change; then
		exit 1
	fi
	exit 0
fi

# Only set/apply take the policy live. Invoked with no action (uci-defaults on
# install) the script just writes the options for whatever mode is already in
# UCI, so there is nothing to reload and nothing to roll back.
applies=0
case "$action" in
	apply|set) applies=1 ;;
esac

previous_mode="$(uci -q get yase_netmode.settings.mode || echo wan_first)"

if ! apply_policy; then
	logger -t "$TAG" "failed to persist exit policy mode=$mode"
	echo "failed to persist exit policy" >&2
	exit 1
fi

if [ "$applies" = "1" ]; then
	# The reload is what makes the policy live, so the mode is persisted only
	# after it succeeds. Writing it first would leave UCI advertising a policy
	# the network never took, which the status page would then report as the
	# applied one.
	if ! /etc/init.d/network reload >/dev/null 2>&1; then
		logger -t "$TAG" "network reload failed after applying mode=$mode, rolling back to mode=$previous_mode"
		rollback_policy "$previous_mode"
		echo "network reload failed" >&2
		exit 1
	fi
fi

if ! commit_mode; then
	logger -t "$TAG" "failed to persist exit policy mode=$mode"
	if [ "$applies" = "1" ]; then
		logger -t "$TAG" "rolling network options back to mode=$previous_mode"
		rollback_policy "$previous_mode"
	fi
	echo "failed to persist exit policy" >&2
	exit 1
fi

if [ "$applies" = "1" ]; then
	# Route both address families through the same live exit. In priority modes
	# this also enables IPv6 on the backup only after IPv4 has failed over.
	sleep 1
	align_ipv6_to_active4 || true
	logger -t "$TAG" "applied exit policy mode=$mode"
fi

if ! reload_proxies_on_exit_change; then
	exit 1
fi

exit 0
