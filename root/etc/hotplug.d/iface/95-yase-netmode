#!/bin/sh

case "$ACTION" in
	ifup|ifdown) ;;
	*) exit 0 ;;
esac

case "$INTERFACE" in
	wan|wan6|usbwan|usbwan6|@usbwan) ;;
	*)
		# Also watch custom interfaces stacked on the 5G uplink.
		[ -n "$INTERFACE" ] || exit 0
		device="$(uci -q get "network.${INTERFACE}.device" || uci -q get "network.${INTERFACE}.ifname" || true)"
		[ "$device" = "@usbwan" ] || exit 0
		;;
esac

# Let netifd finish adding or removing the IPv4 default route before deciding
# which IPv6 client should be active. The command is idempotent and locked.
(
	sleep 1
	/usr/sbin/yase-netmode reconcile >/dev/null 2>&1
) &

exit 0
