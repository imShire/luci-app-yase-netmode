msgid "Network Mode"
msgstr "网络模式"

msgid "Wired WAN"
msgstr "有线 WAN"

msgid "5G modem"
msgstr "5G 蜂窝"

msgid "Other route"
msgstr "其他路由"

msgid "No available exit"
msgstr "暂无可用出口"

msgid "Only exit"
msgstr "唯一出口"

msgid "Disabled by policy"
msgstr "策略已停用"

msgid "Preferred exit"
msgstr "首选出口"

msgid "Fallback exit"
msgstr "备用出口"

msgid "Not configured"
msgstr "未配置"

msgid "Connected"
msgstr "已连接"

msgid "Disconnected"
msgstr "未连接"

msgid "IPv4 in use"
msgstr "IPv4 使用中"

msgid "IPv4 ready"
msgstr "IPv4 可用"

msgid "IPv4 unavailable"
msgstr "IPv4 不可用"

msgid "IPv6 in use"
msgstr "IPv6 使用中"

msgid "IPv6 ready"
msgstr "IPv6 可用"

msgid "IPv6 unavailable"
msgstr "IPv6 不可用"

msgid "No default route is currently available. Check the cable or 5G connection."
msgstr "当前没有可用的默认出口，请检查网线或 5G 连接。"

msgid "Only %s is enabled by the current policy."
msgstr "当前策略仅启用了 %s。"

msgid "%s is unavailable, so traffic has switched to %s."
msgstr "%s 当前不可用，流量已自动切换到 %s。"

msgid "%s is unavailable, so IPv4 has switched to %s. IPv6 remains disabled to avoid splitting traffic across two exits."
msgstr "%s 当前不可用，IPv4 已自动切换到 %s；为避免双栈分流，备用线路的 IPv6 保持停用。"

msgid "IPv4 is using %s. IPv6 is unavailable on the preferred exit, so fallback IPv6 is disabled to avoid splitting traffic."
msgstr "IPv4 正在使用 %s；首选线路没有可用 IPv6，因此备用线路 IPv6 已自动停用，避免流量分走两条线路。"

msgid "IPv4 and IPv6 are using the preferred exit. The fallback will take over when needed."
msgstr "IPv4 与 IPv6 正在使用首选出口；首选出口不可用时，备用出口会自动接管。"

msgid "Traffic is currently using another default route."
msgstr "流量当前正在使用其他默认路由。"

msgid "Current exit: %s"
msgstr "当前出口：%s"

msgid "IPv4: %s · IPv6: %s"
msgstr "IPv4：%s · IPv6：%s"

msgid "Unknown error"
msgstr "未知错误"

msgid "Network exits"
msgstr "网络出口"

msgid "The cards show the live state of each link. Pick an exit mode below and apply it to change the policy."
msgstr "卡片展示各线路的实时状态；在下方选择出口模式并点击应用，才会更改策略。"

msgid "Exit mode"
msgstr "出口模式"

msgid "Automatic failover"
msgstr "断线自动切换"

msgid "Force a single exit"
msgstr "强制只用一条"

msgid "Wired WAN preferred"
msgstr "有线 WAN 优先"

msgid "5G preferred"
msgstr "5G 优先"

msgid "Wired WAN only"
msgstr "仅有线 WAN"

msgid "5G only"
msgstr "仅 5G"

msgid "Uses wired WAN. Switches to 5G automatically when it goes down."
msgstr "走有线 WAN，断线时自动切换到 5G。"

msgid "Uses 5G. Switches to wired WAN automatically when it goes down."
msgstr "走 5G，断线时自动切换到有线 WAN。"

msgid "Uses wired WAN only. The 5G link stays disabled."
msgstr "只走有线 WAN，5G 线路保持停用。"

msgid "Uses 5G only. The wired WAN link stays disabled."
msgstr "只走 5G，有线 WAN 线路保持停用。"

msgid "The selected link is not available"
msgstr "所选线路当前不可用"

msgid "%s is not configured on this device. Choosing it as the only exit leaves no working route until it comes back."
msgstr "%s 在本设备上尚未配置。选为唯一出口后，到它恢复为止将没有可用路由。"

msgid "%s is currently down. Choosing it as the only exit leaves no working route until it comes back."
msgstr "%s 当前处于断开状态。选为唯一出口后，到它恢复为止将没有可用路由。"

msgid "Cancel"
msgstr "取消"

msgid "Continue"
msgstr "继续"

msgid "Selected, not applied yet"
msgstr "已选择，尚未应用"

msgid "Reset to the active mode"
msgstr "恢复为当前生效模式"

msgid "The active exit changed elsewhere. Your unapplied selection was kept."
msgstr "生效出口已在其他地方被更改，你尚未应用的选择已保留。"

msgid "Apply settings"
msgstr "应用设置"

msgid "Applying…"
msgstr "正在应用…"

msgid "Exit selection applied successfully."
msgstr "出口选择已成功应用。"

msgid "Failed to apply exit selection:"
msgstr "出口选择应用失败："

msgid "Another exit policy update is running. Try again in a moment."
msgstr "另一个出口策略更新正在执行，请稍后重试。"

msgid "Failed to save the exit policy."
msgstr "出口策略保存失败。"

msgid "The mode was not saved and the network reload failed. Retry, or check the system log."
msgstr "模式未保存，且网络重载失败。请重试，或检查系统日志。"
